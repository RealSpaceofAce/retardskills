{
  "name": "retardskills",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:secrets": "gitleaks git . --redact --log-level warn && gitleaks dir . --redact --log-level warn",
    "security:semgrep": "semgrep --config p/default --metrics=off --no-git-ignore --exclude node_modules --exclude .next --exclude .git --exclude .vercel --exclude out --exclude .tmp .",
    "security:audit": "npm audit --audit-level=moderate",
    "security:scan": "npm run security:secrets && npm run security:semgrep && npm run security:audit",
    "test:signup": "node scripts/smoke-signup-form.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.51.0",
    "convex": "^1.37.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
